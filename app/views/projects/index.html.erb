<p style="color: green"><%= notice %></p>

<% content_for :title, "Projects" %>

<h1>Projects</h1>

<%# 検索フォーム %>
<div style="background-color: #f5f5f5; padding: 1rem; border-radius: 8px; margin-bottom: 2rem;">
  <%= form_with url: projects_path, method: :get, local: true, style: "display: flex; gap: 0.5rem; align-items: center;" do |f| %>
    <%= f.label :area, "エリアで絞り込み:" %>
    <%= f.select :area, Project::AREAS, { include_blank: "すべてのエリア", selected: params[:area] }, style: "padding: 0.4rem;" %>
    <%= f.submit "検索", style: "padding: 0.4rem 1rem; cursor: pointer;" %>
  <% end %>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
  <% @projects.each do |project| %>
    <%# カード枠 %>
    <div style="border: 1px solid #ddd; border-radius: 8px; overflow: hidden; background-color: white; display: flex; flex-direction: column; justify-content: space-between;">
      
      <div>
        <%# 画像が添付されていればカードの一番上に表示 %>
        <% if project.image.attached? %>
          <div style="height: 180px; width: 100%; overflow: hidden;">
            <%= image_tag project.image, style: "width: 100%; height: 100%; object-fit: cover;" %>
          </div>
        <% else %>
          <%# 画像がない場合のグレー表示 %>
          <div style="height: 180px; width: 100%; background-color: #eee; display: flex; align-items: center; justify-content: center; color: #aaa; font-size: 0.9rem;">
            No Image
          </div>
        <% end %>

        <div style="padding: 1.2rem;">
          <span style="background-color: #e8f5e9; color: #2e5b37; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.8rem; font-weight: bold;">
            <%= project.area %>
          </span>
          <h3 style="margin: 0.8rem 0 0.5rem 0; font-size: 1.2rem;"><%= project.title %></h3>
          <p style="color: #666; font-size: 0.9rem; line-height: 1.4;"><%= truncate(project.description, length: 60) %></p>
        </div>
      </div>

      <div style="padding: 0 1.2rem 1.2rem 1.2rem; margin-top: 1rem; border-top: 1px solid #eee; padding-top: 0.8rem; display: flex; justify-content: space-between; align-items: center;">
        <%= link_to "詳細を見る", project_path(project), style: "color: #2e5b37; font-weight: bold; text-decoration: none;" %>
        
        <%# ログイン中のみ操作用リンクを表示 %>
        <% if user_signed_in? %>
          <div>
            <%= link_to "編集", edit_project_path(project), style: "font-size: 0.8rem; color: #666; margin-right: 0.5rem; text-decoration: none;" %>
            <%= link_to "削除", project_path(project), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, style: "font-size: 0.8rem; color: #c62828; text-decoration: none;" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
