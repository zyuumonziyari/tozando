<p style="color: green"><%= notice %></p>

<% content_for :title, "Projects" %>

<h1>Projects</h1>

<%# 検索フォーム %>
<div style="margin-bottom: 20px; padding: 15px; background-color: #f5f5f5; border-radius: 5px;">
  <%= form_with url: projects_path, method: :get, local: true do |f| %>
    <div>
      <%= f.label :area, "エリアで絞り込む:" %>
      <%= f.select :area, Project::AREAS, { include_blank: "すべてのエリア", selected: params[:area] } %>
      <%= f.submit "検索" %>
      <% if params[:area].present? %>
        <%= link_to "解除", projects_path, style: "margin-left: 10px;" %>
      <% end %>
    </div>
  <% end %>
</div>

<div id="projects">
  <% @projects.each do |project| %>
    <%= render project %>
    <p>
      <%= link_to "Show this project", project %>
    </p>
  <% end %>
</div>

<%# ログイン中（管理者）のみ新規作成ボタンを表示 %>
<% if user_signed_in? %>
  <%= link_to "新規プロジェクト作成", new_project_path %>
<% end %>
