<p style="color: green"><%= notice %></p>

<%= render @project %>

<div>
  <% if user_signed_in? %>
    <%= link_to "編集", edit_project_path(@project) %> |
    <%= button_to "削除", @project, method: :delete, data: { confirm: "本当に削除しますか？" } %> |
  <% end %>
  <%= link_to "一覧に戻る", projects_path %>
</div>
