<%# app/views/projects/_project.html.erb %>

<div style="background-color: white; border: 1px solid #ddd; border-radius: 8px; overflow: hidden; margin-bottom: 1.5rem;">
  
  <%# 画像が添付されている場合は大きく表示 %>
  <% if project.image.attached? %>
    <div style="width: 100%; max-height: 450px; overflow: hidden; background-color: #f5f5f5;">
      <%= image_tag project.image, style: "width: 100%; height: 100%; max-height: 450px; object-fit: cover;" %>
    </div>
  <% end %>

  <div style="padding: 2rem;">
    <%# エリアタグ %>
    <span style="background-color: #e8f5e9; color: #2e5b37; padding: 0.3rem 0.8rem; border-radius: 4px; font-size: 0.9rem; font-weight: bold; display: inline-block; margin-bottom: 0.8rem;">
      <%= project.area %>
    </span>

    <%# タイトル %>
    <h1 style="margin: 0 0 1.5rem 0; font-size: 1.8rem; color: #333; line-height: 1.3;">
      <%= project.title %>
    </h1>

    <hr style="border: none; border-top: 1px solid #eee; margin-bottom: 1.5rem;">

    <%# プロジェクト説明 %>
    <div>
      <h3 style="font-size: 1.1rem; color: #2e5b37; margin-bottom: 0.5rem;">募集・作業内容</h3>
      <div style="font-size: 1rem; line-height: 1.8; color: #444; white-space: pre-wrap;"><%= project.description %></div>
    </div>

    <% if project.apply_url.present? %>
      <div style="text-align: center; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #eee;">
        <%= link_to "応募先・詳細ページへ行く ↗", project.apply_url, target: "_blank", rel: "noopener", style: "background-color: #2e5b37; color: white; padding: 0.9rem 2rem; border-radius: 6px; font-weight: bold; font-size: 1.1rem; text-decoration: none; display: inline-block; box-shadow: 0 4px 6px rgba(0,0,0,0.1);" %>
      </div>
    <% end %>

  </div>
</div>
